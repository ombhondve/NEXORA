# ==============================================================================
# NEXORA FRONTEND (NEXT.JS) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local frontend development:
#   PowerShell: Copy-Item apps/web/.env.example apps/web/.env.local
#   Bash:       cp apps/web/.env.example apps/web/.env.local
#
# CRITICAL SECURITY RULES:
# - NEXT_PUBLIC_* variables are embedded directly into client-side JavaScript.
# - NEVER put secrets, passwords, database URLs, Redis URLs, JWT keys, or private API keys here.
# - Only client-safe, public configuration belongs in this file.
# ==============================================================================

# Application Display Name (shown in browser title and navigation headers)
NEXT_PUBLIC_APP_NAME="NEXORA"

# Backend FastAPI API Base URL
# - Local Development: http://localhost:8000
# - Staging / Preview:  https://your-preview-backend.vercel.app
# - Production:         https://api.nexora.org (or your Vercel backend deployment URL)
NEXT_PUBLIC_API_URL="http://localhost:8000"
