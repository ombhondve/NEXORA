# AI Legal Clue Finder Environment Configuration
# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=

# Groq Model Identifier (defaults to llama-3.3-70b-versatile)
# Supported options: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama3-70b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

