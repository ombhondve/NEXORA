# ==============================================================================
# NEXORA BACKEND (FASTAPI) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to backend/.env for local backend development:
#   PowerShell: Copy-Item backend/.env.example backend/.env
#   Bash:       cp backend/.env.example backend/.env
#
# CRITICAL SECURITY RULES:
# - NEVER commit backend/.env to Git or expose it to client-side bundles.
# - In production (Vercel / Cloud), configure these environment variables in your
#   hosting provider's dashboard or secret manager.
# ==============================================================================

# Application Runtime Environment
# Allowed values: development, test, staging, production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="Recursive OSINT Discovery Engine"
API_V1_PREFIX="/api/v1"
HOST=127.0.0.1
PORT=8000

# Security & JWT Authentication
# In production, SECRET_KEY MUST be a cryptographically secure random string (min 32 chars).
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-this-with-a-secure-random-64-character-hex-string-for-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOW_ANONYMOUS_DEV_AUTH=false
ENABLE_DEV_SEEDS=false

# Allowed Cross-Origin Resource Sharing (CORS) Origins (comma-separated)
# Ensure the deployed Next.js frontend URL is included here in production.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL / Neon / Local Dev)
# ==============================================================================
# Strict Precedence Order:
# 1. DATABASE_NEXORA_POSTGRES_URL (Preferred Neon connection URL configured in Vercel - Pooled)
# 2. DATABASE_NEXORA_DATABASE_URL (Secondary Vercel integration alias)
# 3. DATABASE_URL (Standard local dev / docker fallback)
# 4. Default SQLite (development/test only, strictly forbidden in production)

# 1. Preferred Neon PostgreSQL Connection URL (Pooled endpoint via PgBouncer):
DATABASE_NEXORA_POSTGRES_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# 2. Non-Pooling Direct Connection URL (Used for Alembic migrations and schema DDL):
DATABASE_NEXORA_POSTGRES_URL_NON_POOLING="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require"

# 3. Fallback database URLs:
# DATABASE_NEXORA_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL="postgresql+asyncpg://osint_user:osint_secure_pass@localhost:5432/osint_db"

# Optional Neon Integration Metadata (automatically populated by Vercel Neon Integration):
# DATABASE_NEXORA_POSTGRES_USER="neondb_owner"
# DATABASE_NEXORA_PGHOST="ep-xyz-pooler.us-east-1.aws.neon.tech"
# DATABASE_NEXORA_NEON_PROJECT_ID="ep-xyz"
# DATABASE_NEXORA_POSTGRES_PRISMA_URL=""
# DATABASE_NEXORA_POSTGRES_URL_NO_SSL=""

# Connection Pool Settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_USE_NULLPOOL=false

# ==============================================================================
# REDIS (Task Queue, Rate Limiting & Cache)
# ==============================================================================
# Strict Precedence Order:
# 1. Redis_REDIS_URL (Preferred Vercel Upstash integration variable)
# 2. REDIS_URL (Standard fallback)

Redis_REDIS_URL="redis://default:YOUR_PASSWORD@host:6379"
# REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL_SECONDS=3600

# ==============================================================================
# OPENSEARCH (Full-Text & Vector Search)
# ==============================================================================
OPENSEARCH_URL="http://localhost:9200"
OPENSEARCH_USER=""
OPENSEARCH_PASSWORD=""
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_PREFIX="osint"

# ==============================================================================
# STORAGE CONFIGURATION (Private Uploads & Evidence Artifacts)
# ==============================================================================
STORAGE_BACKEND="local"
STORAGE_LOCAL_ROOT="./storage/uploads"
STORAGE_MAX_FILE_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS="pdf,txt,png,jpg,jpeg,webp"

# ==============================================================================
# INVESTIGATION & RECURSION BUDGET GUARDRAILS
# ==============================================================================
DEFAULT_MAX_DEPTH=3
DEFAULT_MAX_TOTAL_QUERIES=25
DEFAULT_MAX_REQUESTS_PER_CONNECTOR=10
DEFAULT_MAX_EXECUTION_TIME_SECONDS=600
DEFAULT_MAX_DOWNLOAD_BYTES=52428800 # 50 MB
DEFAULT_MAX_AI_TOKENS=25000
DIMINISHING_RETURNS_SIMILARITY_THRESHOLD=0.88

# ==============================================================================
# SSRF AND CRAWLER NETWORK CONTROLS
# ==============================================================================
ENABLE_SSRF_PROTECTION=true
CRAWLER_USER_AGENT="Mozilla/5.0 (compatible; RecursiveOSINTBot/1.0; +https://example.org/bot)"
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_REDIRECTS=3
CRAWLER_MAX_CONTENT_LENGTH=5242880 # 5 MB per webpage
RESPECT_ROBOTS_TXT=true

# ==============================================================================
# AI PROVIDER SETTINGS (Optional - Deterministic mode if omitted)
# ==============================================================================
AI_PROVIDER="none" # Options: none, openai, anthropic, ollama
AI_MODEL_NAME="gpt-4o-mini"
AI_API_KEY=""
AI_BASE_URL=""
AI_MONTHLY_SPEND_LIMIT_USD=50.0

# ==============================================================================
# COMMERCIAL SEARCH PROVIDERS (Optional)
# ==============================================================================
TAVILY_API_KEY=""
SERPER_API_KEY=""
BRAVE_SEARCH_API_KEY=""

# ==============================================================================
# PUBLIC OPEN CONNECTOR TOGGLES (Free/Open - No API keys needed)
# ==============================================================================
ENABLE_WIKIPEDIA_CONNECTOR=true
ENABLE_INTERNET_ARCHIVE_CONNECTOR=true
ENABLE_COMMON_CRAWL_CONNECTOR=true
ENABLE_OPEN_CORPORATES_CONNECTOR=true
ENABLE_CROSSREF_CONNECTOR=true
ENABLE_MOCK_DEMO_CONNECTOR=true
ENABLE_SEARXNG_CONNECTOR=true

# ==============================================================================
# SEARXNG META-SEARCH ENGINE (Local Development: http://localhost:8082)
# ==============================================================================
# Note: http://localhost:8082 is for local development only (do not use in Vercel production)
SEARXNG_URL="http://localhost:8082"
SEARXNG_TIMEOUT_SECONDS=10.0
SEARXNG_MAX_RESULTS=20
SEARXNG_LANGUAGE="en"

