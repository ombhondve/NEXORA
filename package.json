{
  "name": "recursive-osint-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Recursive OSINT Discovery Engine - Enterprise Investigation Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm --prefix apps/web run build",
    "dev": "npm --prefix apps/web run dev",
    "start": "npm --prefix apps/web run start",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "start:web": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "lint:web": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck"
  },
  "dependencies": {
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "keywords": [
    "osint",
    "investigation",
    "recursive-discovery",
    "cybersecurity",
    "full-text-search"
  ],
  "author": "Recursive OSINT Team",
  "license": "Apache-2.0"
}
