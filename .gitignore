# Git Ignore for Recursive OSINT Engine
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
venv/
.venv/
ENV/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.turbo/
*.tsbuildinfo

# Environment and Secrets (Root)
.env
.env.*
!.env.example
!.env.*.example

# Frontend Application Environment (apps/web)
apps/web/.env
apps/web/.env.*
apps/web/.env.local
!apps/web/.env.example
!apps/web/.env.*.example

# Backend Application Environment (backend)
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.*.example

*.pem
*.key
secrets/

# Storage & Runtime Data
storage/uploads/*
!storage/uploads/.gitkeep
storage/data/*
!storage/data/.gitkeep
backend/data/*
*.db
*.sqlite
*.sqlite3

# IDE & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Docker / Logs
*.log
docker-data/
opensearch-data/
postgres-data/
redis-data/
